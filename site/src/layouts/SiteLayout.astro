---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Calmd — notes for the thought in front of you',
  description = 'Calmd is a calm, portable Markdown notes app for developing and retrieving the thought in front of you.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFCF0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100F0F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
