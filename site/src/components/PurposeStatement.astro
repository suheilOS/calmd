---
interface Props {
  number: string
  title: string
  description: string
}

const { number, title, description } = Astro.props
---

<li class="purpose-statement">
  <span class="purpose-number" aria-hidden="true">{number}</span>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</li>
